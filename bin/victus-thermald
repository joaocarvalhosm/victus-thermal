import os
import sys

# Installed as /usr/lib/victus-thermal/bin/victus-thermald (symlinked into /usr/bin or
# started by systemd); in a checkout it lives in bin/. Either way the package
# is one level up.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from victus_thermal.daemon import main  # noqa: E402

sys.exit(main())
