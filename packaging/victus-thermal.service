[Unit]
Description=HP Victus thermal control (fan curves per platform profile)
Documentation=file:///usr/share/doc/victus-thermal/README.md
# Only the hp-wmi module is needed; the profile is read from sysfs. Do not
# order after power-profiles-daemon: on Ubuntu 26.04 it starts after
# multi-user.target, which wants this unit, and systemd breaks that cycle by
# dropping this unit's start job at boot.
After=systemd-modules-load.service
# Other controllers drive the same pwm1_enable knob; never run two at once.
Conflicts=victus-fan.service victus-backend.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/lib/victus-thermal/bin/victus-thermald
# The daemon restores firmware fan control on every exit it can catch; this
# covers the ones it cannot (SIGKILL, OOM, watchdog timeout).
ExecStopPost=/usr/lib/victus-thermal/restore-firmware-fans
Restart=always
RestartSec=3
WatchdogSec=30
TimeoutStopSec=10

# Root is needed only to write the root-owned hp-wmi sysfs files; drop
# everything else. /sys must stay writable, so no ProtectKernelTunables.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/victus-thermal
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0022

[Install]
WantedBy=multi-user.target
